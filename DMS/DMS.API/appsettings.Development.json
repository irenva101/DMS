{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:o}] [{Level:u3}] [{TraceId}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.log",
          "rollOnFileSizeLimit": true,
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:o}] [{Level:u3}] [{TraceId}] {Message}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DmsDb": "User ID=postgres;Password=sotex33;Host=localhost;Port=5432;Database={db_name};Pooling=true;",
    "SharedDb": "User ID=postgres;Password=sotex33;Host=localhost;Port=5432;Database={db_name};Pooling=true;"
  },
  "GITHUB_SHA": "Dms-Local",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Trace"
    }
  },
  "LongMigration": false
}